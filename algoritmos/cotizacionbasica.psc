Algoritmo cotizacionbasica
	Definir Ncliente Como Cadena
	Definir preciohora Como Entero
	Definir horaalquiler Como Entero
	Definir valorTotal Como Real
	Escribir 'ingrese su nombre porfavor'
	Leer Ncliente
	Escribir 'ingrese cuantas horas va usar el servicio'
	Leer horaalquiler
	Escribir 'ingrese  el preciohora del servicio'
	Leer preciohora
	valorTotal <- horaalquiler*preciohora
	Escribir 'Hola ', Ncliente, ': tu alquiler de ', horaalquiler, ' horas  te cuesta pesos ', valorTotal
FinAlgoritmo
